    {
        "id": "26a08b4a0c49d4e3",
        "type": "function",
        "z": "3d6956ce1d3472bd",
        "name": "function 1",
        "func": "// 1. Get the stored value (ensure it's a number)\nlet old = context.get(\"old\") || 0;\n\n// 2. Normalize the input to a string for comparison\nlet inputStr = String(msg.payload).toLowerCase().trim();\n\n// 3. Check for Reset/Off triggers first\nif (inputStr === \"off\" || inputStr === \"reset\" || msg.payload === false || msg.payload === 0) {\n    context.set(\"old\", 0); // Explicitly overwrite the memory\n    msg.payload = 0;\n    return msg;\n}\n\n// 4. If not a reset, try to treat it as a number\nlet incomingValue = Number(msg.payload);\n\nif (!isNaN(incomingValue)) {\n    let newValue = old + incomingValue;\n    context.set(\"old\", newValue); // Save new total\n    msg.payload = newValue;\n} else {\n    node.warn(\"Ignored non-numeric input: \" + msg.payload);\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
