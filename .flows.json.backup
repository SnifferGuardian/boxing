    {
        "id": "17430ecd160b41d6",
        "type": "function",
        "z": "37b7a5f1c787832d",
        "name": "Convert to Base64",
        "func": "// Check if payload exists and is a buffer\nif (Buffer.isBuffer(msg.payload)) {\n    // Convert the raw bytes to a clean Base64 string\n    var b64 = msg.payload.toString('base64');\n    // Add the header so the UI knows it's a PNG\n    msg.payload = \"data:image/png;base64,\" + b64;\n    return msg;\n} else {\n    node.error(\"Payload is not a Buffer! Check Read File node settings.\");\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1370,
        "y": 2340,
        "wires": [
            [
                "ae16253151f17bf4"
            ]
        ]
    },
    {
        "id": "ae16253151f17bf4",
        "type": "ui-template",
        "z": "37b7a5f1c787832d",
        "group": "1cadfd801caa3215",
        "page": "",
        "ui": "",
        "name": "Display Graph",
        "order": 3,
        "width": "8",
        "height": "6",
        "format": "<template>\n    <div class=\"image-container\">\n        <img :src=\"msg.payload\" v-if=\"msg.payload\">\n    </div>\n</template>\n\n<style>\n    /* This removes the scrollbars and forces the image to scale */\n    .image-container {\n        width: 100%;\n        height: 100%;\n        display: flex;\n        justify-content: center;\n        align-items: flex-start;\n        overflow: hidden; /* Prevents scrollbars */\n    }\n\n    .image-container img {\n        width: 100%;      /* Fits width of the widget */\n        height: auto;     /* Keeps the graph from looking 'squashed' */\n        max-height: 100%; /* Ensures it doesn't leak out the bottom */\n        object-fit: contain; \n    }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "templateScope": "local",
        "className": "",
        "x": 1640,
        "y": 2300,
        "wires": [
