    },
    {
        "id": "a0aeb1a1cc2330ea",
        "type": "function",
        "z": "37b7a5f1c787832d",
        "name": "function 3",
        "func": "// 1. Pull the stored values from memory\nlet songPath = flow.get(\"currentSongPath\");\nlet bpmValue = flow.get(\"currentBPM\");\n\n// 2. Validation\nif (!songPath || !bpmValue) {\n    node.warn(\"Missing BPM or Song Path!\");\n    return null;\n}\n\n// 3. Rate limiting (3 second cooldown)\nlet now = Date.now();\nlet lastSent = context.get('lastSent') || 0;\nif (now - lastSent < 3000) return null;\ncontext.set('lastSent', now);\n\n// 4. Prepare Message 1: The Music (PowerShell)\nlet escapedPath = songPath.replace(/\\\\/g, \"\\\\\\\\\");\nconst vlcPath = \"C:\\\\Program Files\\\\VideoLAN\\\\VLC\\\\vlc.exe\";\nlet musicMsg = {\n    payload: `-c \"& '${vlcPath}' --intf dummy --play-and-exit '${escapedPath}'\"`\n};\n\n// 5. Prepare Message 2: The Hardware (Arduino)\n// We add a newline (\\n) so the Arduino knows the number ended\nlet arduinoMsg = {\n    payload: bpmValue.toString() + \"\\n\"\n};\n\n// 6. Return both messages\n// Message 1 goes to the first output, Message 2 to the second\nreturn [musicMsg, arduinoMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1100,
        "y": 2020,
        "wires": [
            [
                "eb94e1e29998f02a"
            ],
            [
                "826efc9e3c4bd04c"
            ]
        ]
    },
