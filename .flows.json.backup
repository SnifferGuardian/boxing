    {
        "id": "826efc9e3c4bd04c",
        "type": "function",
        "z": "37b7a5f1c787832d",
        "name": "function 2",
        "func": "msg.payload = msg.payload + \"\\n\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
